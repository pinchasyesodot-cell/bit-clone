PORT=4005
NODE_ENV=development
# Database Configuration
# Format: mongodb://<host>:<port>/<db_name>
MONGO_URI=mongodb://localhost:27017/bit-clone-saga
# RabbitMQ. For a broker started with docker compose, use the credentials from .env.docker
RABBITMQ_URI=amqp://saga:change-me@localhost:5672
# Base URL of the accounts service. The saga calls GET <URL_ACCOUNTS>/<sagaId>
URL_ACCOUNTS=http://localhost:4010/api/accounts
# must be the same value in every service that verifies tokens
JWT_SECRET=change-me-to-a-long-random-string
# origin of the web client, also the allowed origin for Socket.IO (required)
URL_CLIENT=http://localhost:3000
