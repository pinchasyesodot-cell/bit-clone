# Loaded after .env by docker compose, so these values win.
NODE_ENV=production
# host names are the compose service names, not localhost
MONGO_URI=mongodb://saga-db:27017/bit-clone-saga
RABBITMQ_URI=amqp://saga:change-me@rabbitmq:5672
URL_ACCOUNTS=http://accounts-service:4010/api/accounts
# the broker is created with these credentials, so they must match the ones in RABBITMQ_URI
RABBITMQ_DEFAULT_USER=saga
RABBITMQ_DEFAULT_PASS=change-me
