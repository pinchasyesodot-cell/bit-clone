PORT=4010
NODE_ENV=development
# Database Configuration
# Format: mongodb://<host>:<port>/<db_name>
MONGO_URI=mongodb://localhost:27017/bit-clone-account
# RabbitMQ. For a broker started with docker compose, use the credentials from .env.docker
RABBITMQ_URI=amqp://account:change-me@localhost:5672
# must be the same value in every service that verifies tokens
JWT_SECRET=change-me-to-a-long-random-string
# origin of the web client (required)
URL_CLIENT=http://localhost:3000
