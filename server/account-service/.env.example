PORT=4010
NODE_ENV=development
# Database Configuration
# Format: mongodb://<host>:<port>/<db_name>
MONGO_URI=mongodb://localhost:27017/bit-clone-account?directConnection=true
# RabbitMQ: use the user and password from server/rabbitmq/.env
RABBITMQ_URI=amqp://change-me:change-me@localhost:5672
# must be the same value in every service that verifies tokens
JWT_SECRET=change-me-to-a-long-random-string
# origin of the web client (required)
URL_CLIENT=http://localhost:3000
# Same value as in saga-service. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me
