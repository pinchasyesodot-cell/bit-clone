PORT=4000
NODE_ENV=development
# Database Configuration
# Format: mongodb://<host>:<port>/<db_name>
MONGO_URI=mongodb://localhost:27017/bit-clone-users
# must be the same value in every service that verifies tokens
JWT_SECRET=change-me-to-a-long-random-string
# origin of the web client (browsers are blocked when this is missing)
URL_CLIENT=http://localhost:3000
